{%- liquid
# Component: Theme Button Section (CTA Slide-Effect)
# Description: Customizable slide-effect button section with primary/secondary types
# Usage: Add as section to theme or use with render {% render 'theme-button', button_type: 'primary', button_text: 'Shop Now', button_link: '/shop', button_enabled: true %}
-%}

{%- if section.settings.button_enabled == true or section.settings.button_enabled == blank -%}
<a
  href="{{ section.settings.button_link | default: '#' }}"
  class="theme-button theme-button--{{ section.settings.button_type | default: 'primary' }}"
  data-component="theme-button"
  data-type="{{ section.settings.button_type | default: 'primary' }}"
  data-enabled="true"
  role="button"
  tabindex="0">

  <span class="theme-button__text">{{ section.settings.button_text | default: 'SHOP NOW' }}</span>
  <span class="theme-button__arrow">
  <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L6.72657e-08 4.77298L-6.72657e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.219681C20.2145 -0.0732129 19.7396 -0.0732129 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
</svg>
  </span>
</a>
{%- else -%}
<span
  class="theme-button theme-button--{{ section.settings.button_type | default: 'primary' }}"
  data-component="theme-button"
  data-type="{{ section.settings.button_type | default: 'primary' }}"
  data-enabled="false"
  aria-disabled="true">

  <span class="theme-button__text">{{ section.settings.button_text | default: 'SHOP NOW' }}</span>
  <span class="theme-button__arrow">
  <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.75 4.77298L6.72657e-08 4.77298L-6.72657e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.219681C20.2145 -0.0732129 19.7396 -0.0732129 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
</svg>
  </span>
</span>
{%- endif -%}

{% schema %}
{
  "name": "Theme Button",
  "settings": [
    {
      "type": "checkbox",
      "id": "button_enabled",
      "label": "Enable Button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button Type",
      "options": [
        {
          "value": "primary",
          "label": "Primary (Black)"
        },
        {
          "value": "secondary",
          "label": "Secondary (Yellow)"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "placeholder": "https://example.com"
    }
  ],
  "presets": [
    {
      "name": "Theme Button",
      "settings": {
        "button_enabled": true,
        "button_type": "primary",
        "button_text": "SHOP NOW"
      }
    }
  ]
}
{% endschema %}
