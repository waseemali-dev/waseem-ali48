{%- liquid
  # Theme Header Component
  # Responsive header with mobile-first design
  # Features: hamburger menu, sticky option, editable logo/text, CTA button integration
-%}

<header class="site-header" data-section-id="{{ section.id }}" data-component="site-header">
  <div class="site-header__container">
    
    {%- if section.settings.header_enable -%}
      
      {%- comment -%} Mobile Hamburger Toggle {%- endcomment -%}
      <button class="site-header__toggle" data-action="toggle-menu" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
      </button>

      {%- comment -%} Logo / Branding {%- endcomment -%}
      <div class="site-header__logo">
        {%- if section.settings.logo_image -%}
          <img 
            src="{{ section.settings.logo_image | image_url: width: 200 }}" 
            alt="{{ section.settings.logo_text }}"
            loading="eager"
            style="width: {{ section.settings.logo_width }}px; height: auto; display: block;"
          >
        {%- else -%}
          <span class="site-header__logo-text">{{ section.settings.logo_text }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Center Text (Desktop Only) {%- endcomment -%}
      {%- if section.settings.center_text_enable -%}
        <div class="site-header__text">
          {{ section.settings.center_text }}
        </div>
      {%- endif -%}

      {%- comment -%} CTA Button {%- endcomment -%}
      {%- if section.settings.button_enable -%}
        <div class="site-header__button-wrapper">
          {%- render 'theme-button',
            button_enabled: section.settings.button_enable,
            button_type: section.settings.button_type,
            button_text: section.settings.button_text,
            button_link: section.settings.button_link
          -%}
        </div>
      {%- endif -%}

      {%- comment -%} Mobile Menu (Hidden by default) {%- endcomment -%}
      <nav class="site-header__menu" data-component="mobile-menu">
        <div class="site-header__menu-content">
          <p>{{ section.settings.menu_text }}</p>
        </div>
      </nav>

    {%- endif -%}

  </div>
</header>

{%- comment -%} Inject CSS and JS {%- endcomment -%}
{{ 'site-header.css' | asset_url | stylesheet_tag }}

<script src="{{ 'site-header.js' | asset_url }}" defer></script>

{%- comment -%} Preload/Prefetch critical resources {%- endcomment -%}
<link rel="prefetch" href="{{ 'site-header.js' | asset_url }}">
<link rel="prefetch" href="{{ 'theme-button.css' | asset_url }}">

{% schema %}
{
  "name": "Site Header",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "checkbox",
      "id": "header_enable",
      "label": "Enable Header",
      "default": true
    },
    {
      "type": "header",
      "content": "Logo & Branding"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "default": "120"
    },
    {
      "type": "header",
      "content": "Center Text (Desktop)"
    },
    {
      "type": "checkbox",
      "id": "center_text_enable",
      "label": "Show Center Text",
      "default": true
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "checkbox",
      "id": "button_enable",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button Type",
      "options": [
        { "value": "primary", "label": "Primary (Black)" },
        { "value": "secondary", "label": "Secondary (Yellow)" }
      ],
      "default": "secondary"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Header Styling"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "sticky_enable",
      "label": "Enable Sticky Header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_shadow",
      "label": "Add Shadow on Scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "menu_text",
      "label": "Mobile Menu Text",
      "default": "Menu items will appear here"
    }
  ],
  "presets": [
    {
      "name": "Site Header",
      "settings": {}
    }
  ]
}
{% endschema %}