<header class="site-header" data-section-id="{{ section.id }}" data-component="site-header">
  <div class="site-header__container page-width">
    
    {%- if section.settings.header_enable -%}
      
      {%- comment -%} Mobile Hamburger Toggle {%- endcomment -%}
      <button class="site-header__toggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu-{{ section.id }}">
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
        <span class="site-header__toggle-line"></span>
      </button>

      {%- comment -%} Logo / Branding {%- endcomment -%}
      <a href="{{ shop.url }}" class="site-header__logo">
        {%- if section.settings.logo_image -%}
          <img 
            src="{{ section.settings.logo_image | image_url: width: 151 }}" 
            alt="{{ section.settings.logo_text }}"
            loading="eager" width="151" height="19"
            style="width: {{ section.settings.logo_width }}px; height: auto; display: block;"
          >
        {%- else -%}
          <span class="site-header__logo-text">{{ section.settings.logo_text }}</span>
        {%- endif -%}
      </a>

      {%- comment -%} Center Text (Desktop Only) {%- endcomment -%}
      {%- if section.settings.center_text_enable -%}
        <div class="site-header__text">
          {{ section.settings.center_text }}
        </div>
      {%- endif -%}

      {%- comment -%} CTA Button (Desktop Only) {%- endcomment -%}
      {%- if section.settings.button_enable -%}
        <div class="site-header__button-wrapper">
          {%- render 'theme-button',
            button_enabled: section.settings.button_enable,
            button_type: section.settings.button_type,
            button_text: section.settings.button_text,
            button_link: section.settings.button_link
          -%}
        </div>
      {%- endif -%}

      {%- comment -%} Mobile Menu (Collapsed by default) {%- endcomment -%}
      <nav id="mobile-menu-{{ section.id }}" class="site-header__menu" data-component="mobile-menu" aria-hidden="true">
        <div class="site-header__menu-content">
          
          {%- comment -%} Center Text in Menu {%- endcomment -%}
          {%- if section.settings.center_text_enable -%}
            <div class="site-header__menu-text">
              {{ section.settings.center_text }}
            </div>
          {%- endif -%}

          {%- comment -%} Button in Menu {%- endcomment -%}
          {%- if section.settings.button_enable -%}
            <div class="site-header__menu-button">
              {%- render 'theme-button',
                button_enabled: section.settings.button_enable,
                button_type: section.settings.button_type,
                button_text: section.settings.button_text,
                button_link: section.settings.button_link
              -%}
            </div>
          {%- endif -%}

        </div>
      </nav>

    {%- endif -%}

  </div>
</header>

{{ 'site-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'site-header.js' | asset_url }}" defer></script>

<link rel="prefetch" href="{{ 'site-header.js' | asset_url }}">
<link rel="prefetch" href="{{ 'theme-button.css' | asset_url }}">

{% schema %}
{
  "name": "Site Header",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "checkbox",
      "id": "header_enable",
      "label": "Enable Header",
      "default": true
    },
    {
      "type": "header",
      "content": "Logo & Branding"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "default": "151"
    },
    {
      "type": "header",
      "content": "Center Text (Desktop & Mobile Menu)"
    },
    {
      "type": "checkbox",
      "id": "center_text_enable",
      "label": "Show Center Text",
      "default": true
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "header",
      "content": "CTA Button (Desktop & Mobile Menu)"
    },
    {
      "type": "checkbox",
      "id": "button_enable",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button Type",
      "options": [
        { "value": "primary", "label": "Primary (Black)" },
        { "value": "secondary", "label": "Secondary (Yellow)" }
      ],
      "default": "secondary"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
   
  ],
  "presets": [
    {
      "name": "Site Header",
      "settings": {}
    }
  ]
}
{% endschema %}
