<section class="prod-list" data-comp="prod-list">
  <div class="prod-list__hd">
    <h2 class="prod-list__hd-txt">Featured Products</h2>
  </div>

  <div class="prod-list__grid">
    {% for product in collection.products limit: 6 %}
      <div class="prod-list__card" data-prod-card data-product-id="{{ product.id }}" data-product-name="{{ product.title | escape }}" data-product-price="{{ product.price | money }}" data-product-image="{{ product.featured_image | image_url: width: 400 }}" data-product-desc="{{ product.description | strip_html | escape }}" data-product-colors='[{"name": "Black", "value": "#000000"}, {"name": "White", "value": "#FFFFFF"}]' data-product-sizes='["XS", "S", "M", "L", "XL", "XXL"]' data-product-variants='[{"id": 1, "size": "M", "color": "#000000"}, {"id": 2, "size": "L", "color": "#000000"}, {"id": 3, "size": "M", "color": "#FFFFFF"}]'>
        <div class="prod-list__img-wrap">
          <img class="prod-list__img" src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | default: product.title }}">
          <button class="prod-list__hotspot" data-hotspot type="button" aria-label="Quick view {{ product.title | escape }}" aria-haspopup="dialog">+</button>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- MODAL -->
  <div class="prod-modal" data-modal="prod">
    <div class="prod-modal__overlay" data-modal-overlay></div>

    <div class="prod-modal__content">
      <button class="prod-modal__close" data-modal-close type="button" aria-label="Close">×</button>

      <div class="prod-modal__body">
        <img class="prod-modal__img" data-modal-img src="" alt="">

        <div class="prod-modal__info">
          <h3 class="prod-modal__name" data-modal-name></h3>
          <p class="prod-modal__price" data-modal-price></p>
          <p class="prod-modal__desc" data-modal-desc></p>
        </div>
      </div>

      <div class="prod-modal__form">
        <!-- COLOR OPTIONS -->
        <div class="prod-modal__colors">
          <label class="prod-modal__color-label">Color</label>
          <div class="prod-modal__color-opts" data-colors>
            <div class="prod-modal__slider"></div>
          </div>
        </div>

        <!-- SIZE DROPDOWN -->
        <div class="prod-modal__size">
          <label class="prod-modal__size-label">Size</label>
          <select class="prod-modal__dropdown" data-size>
            <option value="">Choose your size</option>
          </select>
        </div>

        <!-- ADD TO CART -->
        <button class="prod-modal__btn" data-add-cart type="button">Add to Cart</button>
      </div>
    </div>
  </div>
</section>

<style>
  {% include 'product-listing.css' %}
</style>

<script>
  {% include 'product-listing.js' %}
</script>