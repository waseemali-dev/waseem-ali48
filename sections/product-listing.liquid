{%- liquid
  # Component: Product Listing
  # Description: Grid of featured products from a selected collection with
  #   quick-add popup. Each product card has a hotspot button that opens a
  #   shared modal showing that product's real name/price/description/variants,
  #   with dynamic color + size selection and Add to Cart. No external
  #   dependencies - vanilla JS only.
  # Products limit: configurable 1-12 via theme editor
  # Collection: picker in theme editor
  # Color/Size: extracted from product variants at render time

  assign collection_id = section.settings.collection
  assign products_limit = section.settings.products_limit
  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color
-%}

<section
  class="product-listing"
  data-section-id="{{ section.id }}"
  data-component="product-listing"
>
  <style>
    .product-listing[data-section-id="{{ section.id }}"] {
      --product-listing-heading-color: {{ heading_color }};
      --product-listing-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --product-listing-padding-top-tablet: {{ section.settings.padding_top_tablet }}px;
      --product-listing-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --product-listing-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --product-listing-padding-bottom-tablet: {{ section.settings.padding_bottom_tablet }}px;
      --product-listing-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    }
  </style>

  <div class="product-listing__container page-width">

    {%- if heading != blank -%}
      <h2 class="product-listing__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if collection_id != blank -%}
      {%- assign collection = collections[collection_id] -%}

      {%- if collection.products.size > 0 -%}
        <div class="product-listing__grid">
          {%- for product in collection.products limit: products_limit -%}

            {%- comment -%}
              Extract color and size options from this product's variants.
              Colors come from the first unique option across all variants;
              sizes from the second. Data is serialized to JSON and read by
              product-listing.js when this product's hotspot is clicked.
            {%- endcomment -%}

            {%- capture colors_json -%}
              [
                {%- for option in product.options -%}
                  {%- if option.name == 'Color' or option.name == 'color' -%}
                    {%- for value in option.values -%}
                      {"name": "{{ value | escape }}", "value": "{{ value | escape }}"}
                      {%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              ]
            {%- endcapture -%}

            {%- capture sizes_json -%}
              [
                {%- for option in product.options -%}
                  {%- if option.name == 'Size' or option.name == 'size' -%}
                    {%- for value in option.values -%}
                      "{{ value | escape }}"
                      {%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              ]
            {%- endcapture -%}

            {%- capture variants_json -%}
              [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "price": {{ variant.price | money | json }},
                    "available": {{ variant.available | json }},
                    "size": "{{ variant.option1 | default: variant.option2 | default: variant.option3 | escape }}",
                    "color": "{{ variant.option2 | default: variant.option1 | default: variant.option3 | escape }}"
                  }
                  {%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            {%- endcapture -%}

            <div class="product-listing__card">
              <div class="product-listing__media">
                <img
                  class="product-listing__image"
                  src="{{ product.featured_image | image_url: width: 500 }}"
                  srcset="
                    {{- product.featured_image | image_url: width: 300 }} 300w,
                    {{ product.featured_image | image_url: width: 500 }} 500w,
                    {{ product.featured_image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >

                <button
                  type="button"
                  class="product-listing__hotspot"
                  data-action="open-quick-add"
                  data-product-id="{{ product.id }}"
                  aria-label="Quick add {{ product.title | escape }}"
                  aria-haspopup="dialog"
                >
                  +
                </button>

                {%- comment -%}
                  Product data for this card. Read by product-listing.js
                  when its hotspot is clicked. All variant and option data
                  is embedded here for fast popup rendering.
                {%- endcomment -%}
                <script type="application/json" data-product-json>
                  {
                    "id": {{ product.id | json }},
                    "title": {{ product.title | json }},
                    "price": {{ product.price | money | json }},
                    "image": {{ product.featured_image | image_url: width: 400 | json }},
                    "description": {{ product.description | strip_html | json }},
                    "colors": {{ colors_json | strip_newlines }},
                    "sizes": {{ sizes_json | strip_newlines }},
                    "variants": {{ variants_json | strip_newlines }}
                  }
                </script>
              </div>
            </div>

          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>

  {%- comment -%}
    Single shared modal, reused for whichever product's hotspot was clicked.
    Placeholder structure only - product-listing.js populates the dynamic
    parts (image/title/price/description/colors/sizes) each time it opens.
  {%- endcomment -%}
  <div class="product-listing__overlay" data-quick-add-overlay hidden>
    <div
      class="product-listing__modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ProductListingModalTitle-{{ section.id }}"
      data-quick-add-modal
    >
      <button
        type="button"
        class="product-listing__modal-close"
        data-action="close-quick-add"
        aria-label="Close"
      >
        ×
      </button>

      <div class="product-listing__modal-body">
        <img
          class="product-listing__modal-image"
          data-modal-image
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
          alt=""
          width="250"
          height="250"
        >

        <div class="product-listing__modal-info">
          <h3 class="product-listing__modal-title" id="ProductListingModalTitle-{{ section.id }}" data-modal-title></h3>
          <p class="product-listing__modal-price" data-modal-price></p>
          <p class="product-listing__modal-description" data-modal-description></p>
        </div>
      </div>

      <div class="product-listing__modal-controls">
        <div class="product-listing__control-group" data-color-group hidden>
          <label class="product-listing__control-label">Color</label>
          <div class="product-listing__color-options" data-color-options>
            <div class="product-listing__color-slider" data-color-slider></div>
          </div>
        </div>

        <div class="product-listing__control-group" data-size-group hidden>
          <label class="product-listing__control-label">Size</label>
          <select class="product-listing__dropdown" data-size-dropdown>
            <option value="">Choose your size</option>
          </select>
        </div>

        <p class="product-listing__status" data-status role="status" aria-live="polite"></p>

        <button
          type="button"
          class="product-listing__add-to-cart"
          data-action="add-to-cart"
        >
          Add to Cart
        </button>
      </div>
    </div>
  </div>
</section>

{{ 'product-listing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-listing.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Listing",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (tablet)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (tablet)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product Listing"
    }
  ]
}
{% endschema %}